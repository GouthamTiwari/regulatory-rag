# Copy this file to .env and fill in the values you need.
# .env is gitignored: real keys must never be committed.
# Every value here is deliberately left empty.

# ---------------------------------------------------------------------------
# AWS region
# ---------------------------------------------------------------------------

# Region for every Bedrock call. Recommended: ap-northeast-1 (Tokyo).
# Fallback: us-east-1. Nothing in the code hard-codes a region.
AWS_REGION=

# ---------------------------------------------------------------------------
# AWS authentication: set only one auth option (A or B), never both.
# ---------------------------------------------------------------------------

# Option A (recommended): a long-term Bedrock API key with a 30-day expiry.
# It can only call Bedrock, and it expires on its own if it ever leaks.
AWS_BEARER_TOKEN_BEDROCK=

# Option B: IAM user access key ID. Leave empty if you use Option A.
AWS_ACCESS_KEY_ID=

# Option B: IAM user secret access key. Leave empty if you use Option A.
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Bedrock model IDs (leave empty to use the defaults in config.py)
# ---------------------------------------------------------------------------

# Embeddings. Recommended: amazon.titan-embed-text-v2:0
BEDROCK_EMBED_MODEL_ID=

# Reranker. Recommended: cohere.rerank-v3-5:0 (fallback: amazon.rerank-v1:0)
BEDROCK_RERANK_MODEL_ID=

# Router and answer model. Recommended: global.anthropic.claude-haiku-5-5
# (an inference profile is required; the base model ID does not work on-demand).
BEDROCK_LLM_MODEL_ID=

# Faithfulness judge. Leave empty to use the default (Claude Haiku 5.5, for development runs).
# Set it to global.anthropic.claude-sonnet-5-5 only for the final reported eval run (Task 28).
BEDROCK_JUDGE_MODEL_ID=

# ---------------------------------------------------------------------------
# Local Postgres + pgvector (Docker)
# ---------------------------------------------------------------------------

# Database user for the local container. Suggested: regrag
POSTGRES_USER=

# Password for the local container. Pick a new one; never reuse a real password.
POSTGRES_PASSWORD=

# Database name. Suggested: regrag
POSTGRES_DB=

# Host port for the container. Recommended: 5433 (avoids any Postgres already on 5432).
POSTGRES_PORT=

# Connection string built from the four values above, in the form
# postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=
